<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.App.Toolbar.Title"
        app:titleTextColor="@color/text"
        app:subtitle="自动识别 · 精确匹配 · 招募记录"
        app:subtitleTextColor="@color/text_dim" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navAuto"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navAutoIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_scan" />

            <TextView
                android:id="@+id/navAutoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_auto"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navManual"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navManualIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tags" />

            <TextView
                android:id="@+id/navManualLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_manual"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRecords"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navRecordsIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_history" />

            <TextView
                android:id="@+id/navRecordsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_records"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
