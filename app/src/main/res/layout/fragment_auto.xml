<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动识别"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="3dp"
            android:text="游戏内助手：悬浮球 + 半屏结果 + 自动点选；也可以从截图或相册做离线分析。"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="游戏内助手"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="启动后回到游戏，点悬浮球即可分析；点结果里的角色会自动改词条和招募时间。首次使用需开启无障碍，录屏授权一次后本次会话内复用。"
                android:textColor="#B9C6E8"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/assistantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="助手未启动。"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnAssistant"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="启动游戏内助手"
                android:textColor="#0B0E18"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnStopAssistant"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_outline"
                android:gravity="center"
                android:text="停止助手"
                android:textColor="@color/text"
                android:textSize="13.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAssistantSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="助手设置（词条 / 时间 / 开始招募）"
                android:textColor="@color/primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnBackgroundSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="后台运行设置（真我 / OPPO）"
                android:textColor="@color/primary"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="真我/OPPO 等系统建议把本应用设为「允许后台活动」，否则系统可能在一次识别后中断录屏会话。"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备用：截图分析"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="识别在图例区域出现的词条，支持简体 / 繁体。截屏识别会调用系统屏幕录制权限，只抓取一帧，不上传任何图片。"
                android:textColor="#B9C6E8"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="截屏识别"
                android:textColor="#0B0E18"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnGallery"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="center"
                    android:text="从图片识别"
                    android:textColor="@color/text"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSample"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="center"
                    android:text="示例图识别"
                    android:textColor="@color/text"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDemo"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_button_outline"
                android:gravity="center"
                android:text="打开模拟征才面板（验证助手）"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="等待识别。也可以直接使用「示例图识别」体验完整流程。"
            android:textColor="@color/text_dim"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_card_soft"
            android:maxHeight="300dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/recognizedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="识别到的词条"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recognizedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_soft"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="0 个"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnRaw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="识别详情"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="识别结果可直接修改，增删词条后会立即重新计算。"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.tkfm.recruitassistant.ui.TagPickerView
                android:id="@+id/autoPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/rawCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_soft"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OCR 原文"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rawText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_dim"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
